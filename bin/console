#!/usr/bin/env ruby

require 'bundler/setup'
require 'dotenv/load'
require 'scrapin'

# Logs in once and reuses the session. Watch it at http://localhost:7900.
#   session.linkedin_scrap_threads.execute(5) { |name, link| puts name, link }
#   page = session.capybara  # poke at selectors: page.all('.msg-conversation-listitem')
def session(linkedin: true)
  @session ||= ScrapIn::Session.new(ENV['username'], ENV['password'], linkedin)
end

puts 'Call `session` to log in (watch at http://localhost:7900).'

require 'irb'
IRB.start(__FILE__)
